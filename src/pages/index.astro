---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import CapabilityGrid from '../components/CapabilityGrid.astro';
import EngagementModes from '../components/EngagementModes.astro';
import HeroCloud from '../components/HeroCloud.astro';
import { site } from '../content/site';
import { projects } from '../content/projects';
import ProjectsTable from '../components/ProjectsTable.astro';
---

<Layout title={`${site.name} — ${site.hero.heading}`} description={site.hero.subheading}>
	<Header
		brand={{ name: site.name, tagline: site.tagline }}
		links={[
			{ label: 'Approach', href: '#approach' },
			{ label: 'Services', href: '#services' },
			{ label: 'Contact', href: '#contact' },
		]}
		cta={{ label: site.hero.primaryCta.label, href: site.hero.primaryCta.href }}
	/>

	<main>
		<section class="hero">
			<div class="container heroInner">
				<div class="heroCopy">
					<div class="pill">
						<span class="dot" aria-hidden="true"></span>
						<span>{site.proof.kicker}</span>
					</div>
					<h1 class="heroTitle">{site.hero.heading}</h1>
					<p class="heroLead">{site.hero.subheading}</p>
					<div class="heroCtas">
						<a class="btn primary" href={site.hero.primaryCta.href}>{site.hero.primaryCta.label}</a>
						<a class="btn" href={site.hero.secondaryCta.href}>{site.hero.secondaryCta.label}</a>
					</div>

					{site.proof.items.length ? (
						<div class="proof">
							{site.proof.items.map((i) => (
								<span class="proofItem">{i}</span>
							))}
						</div>
					) : null}
				</div>

				<div class="heroArt">
					<HeroCloud />
				</div>
			</div>
		</section>

		<Section
			id="about"
			eyebrow={site.about.eyebrow}
			title={site.about.title}
			lead={site.about.lead}
		>
			<div class="aboutGrid">
				<article class="card aboutCard">
					<h3 class="aboutTitle">Beyond the dark cloud</h3>
					<p class="muted aboutBody">
						Our brightest purpose is creating solutions that genuinely improve lives.
						Every interface we design and every feature we ship is guided by a simple question:
						How will this make someone’s day-to-day better?
					</p>
				</article>
				<article class="card aboutCard">
					<h3 class="aboutTitle">Intelligent solutions</h3>
					<p class="muted aboutBody">
						We build products where AI meets usability — from mobile applications to scalable SaaS.
						The goal is always the same: ship something people can trust, understand, and keep using.
					</p>
				</article>
			</div>
		</Section>

		<Section
			id="approach"
			eyebrow={site.approach.eyebrow}
			title={site.approach.title}
			lead={site.approach.lead}
		>
			<div class="steps">
				{site.approach.steps.map((s, idx) => (
					<article class="card step">
						<div class="num">{String(idx + 1).padStart(2, '0')}</div>
						<div>
							<h3 class="stepTitle">{s.title}</h3>
							<p class="muted stepBody">{s.body}</p>
						</div>
					</article>
				))}
			</div>
		</Section>

		<Section
			id="services"
			variant="panel"
			eyebrow={site.capabilities.eyebrow}
			title={site.capabilities.title}
			lead={site.capabilities.lead}
		>
			<CapabilityGrid items={site.capabilities.items} />
		</Section>

		<Section
			id="offerings"
			variant="panel"
			eyebrow={site.engagement.eyebrow}
			title={site.engagement.title}
			lead={site.engagement.lead}
		>
			<EngagementModes modes={site.engagement.modes} />
		</Section>

		<Section
			id="projects"
			eyebrow="Projects"
			title="Selected work"
			lead="A small sampling of what we’ve shipped and explored. (These are placeholders—next step is adding real summaries and screenshots.)"
		>
			<ProjectsTable projects={projects} />
		</Section>

		<Section
			eyebrow={site.differentiator.eyebrow}
			title={site.differentiator.title}
			lead={site.differentiator.lead}
		>
			<div class="points">
				{site.differentiator.points.map((p) => (
					<article class="card point">
						<h3 class="pointTitle">{p.title}</h3>
						<p class="muted pointBody">{p.body}</p>
					</article>
				))}
			</div>
		</Section>

		<Section
			id="contact"
			variant="panel"
			eyebrow={site.contact.eyebrow}
			title={site.contact.title}
			lead={site.contact.lead}
		>
			<form class="form" action="#" method="post">
				<label class="field">
					<span class="label">{site.contact.form.nameLabel}</span>
					<input class="input" name="name" autocomplete="name" />
				</label>
				<label class="field">
					<span class="label">{site.contact.form.emailLabel}</span>
					<input class="input" name="email" type="email" autocomplete="email" />
				</label>
				<label class="field fieldFull">
					<span class="label">{site.contact.form.messageLabel}</span>
					<textarea class="input textarea" name="message" rows={5}></textarea>
				</label>
				<label class="field fieldFull">
					<span class="label">{site.contact.form.referralLabel}</span>
					<select class="input" name="referral">
						{site.contact.form.referrals.map((r) => (
							<option value={r}>{r}</option>
						))}
					</select>
				</label>

				<div class="formActions">
					<button class="btn primary" type="submit">{site.contact.form.submitLabel}</button>
					<p class="muted fineprint">
						This form is currently static (no backend yet). Next step is wiring it to your preferred handler.
					</p>
				</div>
			</form>
		</Section>

		<Footer brandName={site.name} links={site.footer.links} />
	</main>
</Layout>

<style>
	.hero {
		padding: clamp(3.5rem, 7vw, 6rem) 0 2.5rem;
	}
	.heroInner {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2rem;
		align-items: center;
	}
	.heroCopy {
		display: grid;
		gap: 1rem;
	}
	.heroTitle {
		margin: 0;
		font-size: clamp(2.35rem, 5vw, 3.7rem);
		letter-spacing: -0.04em;
		line-height: 1.02;
	}
	.heroLead {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.7;
		max-width: 70ch;
		color: rgba(var(--fog-0), 0.82);
	}
	.heroCtas {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 0.35rem;
	}
	.proof {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 0.65rem;
	}
	.proofItem {
		font-size: 0.9rem;
		color: rgba(var(--fog-1), 0.9);
		border: 1px solid rgba(var(--fog-2), 0.2);
		background: rgba(var(--bg-2), 0.18);
		padding: 0.35rem 0.55rem;
		border-radius: 999px;
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: rgba(var(--accent-1), 0.95);
		box-shadow: 0 0 0 6px rgba(var(--accent-0), 0.16);
	}

	.heroArt {
		display: grid;
		gap: 0.75rem;
	}

	.aboutGrid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	.aboutCard {
		padding: 1.1rem 1.15rem;
	}
	.aboutTitle {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}
	.aboutBody {
		margin: 0.5rem 0 0;
		line-height: 1.65;
	}

	.steps {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	.step {
		padding: 1.1rem 1.15rem;
		display: grid;
		grid-template-columns: 52px 1fr;
		gap: 0.9rem;
		align-items: start;
	}
	.num {
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgba(var(--fog-2), 0.85);
		background: rgba(var(--bg-2), 0.18);
		border: 1px solid rgba(var(--fog-2), 0.22);
		width: 52px;
		height: 52px;
		display: grid;
		place-items: center;
		border-radius: 18px;
	}
	.stepTitle {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}
	.stepBody {
		margin: 0.35rem 0 0;
		line-height: 1.6;
	}

	.points {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	.point {
		padding: 1.1rem 1.15rem;
	}
	.pointTitle {
		margin: 0;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
	}
	.pointBody {
		margin: 0.5rem 0 0;
		line-height: 1.6;
	}

	.form {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.9rem;
	}
	.field {
		display: grid;
		gap: 0.45rem;
	}
	.label {
		font-size: 0.95rem;
		color: rgba(var(--fog-1), 0.92);
	}
	.input {
		width: 100%;
		border-radius: 14px;
		border: 1px solid rgba(var(--fog-2), 0.22);
		background: rgba(var(--bg-0), 0.35);
		color: rgba(var(--fog-0), 0.92);
		padding: 0.85rem 0.9rem;
		font: inherit;
	}
	.input:focus {
		outline: none;
		border-color: rgba(var(--accent-1), 0.35);
		box-shadow: 0 0 0 4px rgba(var(--accent-0), 0.12);
	}
	.textarea {
		resize: vertical;
		min-height: 120px;
	}
	.formActions {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.35rem;
	}
	.fineprint {
		margin: 0;
		font-size: 0.92rem;
		max-width: 62ch;
	}

	@media (min-width: 880px) {
		.heroInner {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 2.25rem;
		}
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.points {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.form {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.fieldFull {
			grid-column: 1 / -1;
		}
		.aboutGrid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
