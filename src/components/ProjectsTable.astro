---
import type { Project } from '../content/projects';

type Props = {
	projects: ReadonlyArray<Project>;
};

const { projects } = Astro.props;
---

<div class="wrap card">
	<div class="head muted">
		<div>Title</div>
		<div>Date</div>
		<div>Type</div>
	</div>
	<div class="rows">
		{projects.map((p) => (
			<a class="row" href={`/projects/${p.slug}`}>
				<div class="title">{p.title}</div>
				<div class="meta">{p.date}</div>
				<div class="meta">{p.type}</div>
			</a>
		))}
	</div>
</div>

<style>
	.wrap {
		padding: 0.75rem;
		overflow: hidden;
	}
	.head {
		display: grid;
		grid-template-columns: 1.6fr 0.6fr 0.6fr;
		gap: 1rem;
		padding: 0.9rem 1rem;
		border-bottom: 1px solid rgba(var(--fog-2), 0.14);
		font-size: 0.95rem;
	}
	.rows {
		display: grid;
	}
	.row {
		display: grid;
		grid-template-columns: 1.6fr 0.6fr 0.6fr;
		gap: 1rem;
		padding: 1.1rem 1rem;
		border-radius: 14px;
		color: rgba(var(--fog-0), 0.9);
		transition: background-color 200ms var(--ease-out), transform 200ms var(--ease-out);
	}
	.row:hover {
		background: rgba(var(--bg-2), 0.22);
		transform: translateY(-1px);
	}
	.title {
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.meta {
		color: rgba(var(--fog-1), 0.9);
	}
	@media (max-width: 720px) {
		.head,
		.row {
			grid-template-columns: 1fr;
		}
		.head {
			display: none;
		}
		.row {
			gap: 0.35rem;
		}
	}
</style>

