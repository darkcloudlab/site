---
// Interactive “cloud” mesh (ported from prior dev hero).
// Renders a draggable wavy grid using Three.js + GSAP.
---

<div class="wrap">
	<canvas id="hero-cloud-canvas" class="canvas"></canvas>
</div>

<style>
	.wrap {
		width: 100%;
		height: 100%;
		min-height: 360px;
		position: relative;
		overflow: visible;
	}
	.canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	@media (prefers-reduced-motion: reduce) {
		.canvas {
			display: none;
		}
	}
</style>

<script>
	import * as THREE from 'three';
	import { gsap } from 'gsap';

	class WavyMesh {
		private scene: THREE.Scene;
		private camera: THREE.PerspectiveCamera;
		private renderer: THREE.WebGLRenderer;
		private geometry!: THREE.BufferGeometry;
		private material!: THREE.LineBasicMaterial;
		private mesh!: THREE.LineSegments;
		private mouse: THREE.Vector2;
		private previousMouse: THREE.Vector2;
		private originalPositions!: Float32Array;
		private isDragging: boolean;
		private isPointerOver: boolean;
		private resizeObserver!: ResizeObserver;
		private activePointerId: number | null;
		private containerScale: number;
		private meshWidth: number;
		private meshHeight: number;

		constructor(canvas: HTMLCanvasElement) {
			this.scene = new THREE.Scene();
			this.scene.background = null;

			this.camera = new THREE.PerspectiveCamera(45, 1, 0.1, 1000);
			this.camera.position.set(0, -90, 90);
			this.camera.lookAt(0, 0, 0);

			this.renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
			this.renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

			this.mouse = new THREE.Vector2(0, 0);
			this.previousMouse = new THREE.Vector2(0, 0);
			this.isDragging = false;
			this.isPointerOver = false;
			this.activePointerId = null;
			this.containerScale = 1;
			this.meshWidth = 60;
			this.meshHeight = 80;

			this.setupResizeObserver(canvas);
			this.createMesh();
			this.setupEventListeners(canvas);
			this.updateSize();
			this.frameToView();
			this.render();
		}

		private frameToView(): void {
			if (!this.mesh) return;

			// Fit the mesh to the current camera aspect so it never clips on narrow screens.
			const box = new THREE.Box3().setFromObject(this.mesh);
			const size = new THREE.Vector3();
			const center = new THREE.Vector3();
			box.getSize(size);
			box.getCenter(center);

			// Guard against NaNs from empty boxes.
			if (![size.x, size.y, size.z, center.x, center.y, center.z].every(Number.isFinite)) return;

			const vFov = THREE.MathUtils.degToRad(this.camera.fov);
			const hFov = 2 * Math.atan(Math.tan(vFov / 2) * this.camera.aspect);

			const distanceForHeight = (size.y / 2) / Math.tan(vFov / 2);
			const distanceForWidth = (size.x / 2) / Math.tan(hFov / 2);
			const distance = Math.max(distanceForHeight, distanceForWidth);

			const pad = 1.18;
			const dir = this.camera.position.clone().sub(center).normalize();
			if (![dir.x, dir.y, dir.z].every(Number.isFinite) || dir.lengthSq() < 1e-6) {
				dir.set(0, -1, 1).normalize();
			}

			this.camera.position.copy(center).add(dir.multiplyScalar(distance * pad));
			this.camera.lookAt(center);
			this.camera.updateProjectionMatrix();
		}

		private createMesh(): void {
			const container = this.renderer.domElement.parentElement;
			const rect = container?.getBoundingClientRect();
			const containerWidth = rect?.width || window.innerWidth;

			// Larger base dimensions so the mesh fills the hero space.
			const baseWidth = 82;
			const baseHeight = 112;
			const maxWidth = 1024;

			let scale = 1;
			if (containerWidth < maxWidth) scale = containerWidth / maxWidth;
			// Push the whole mesh larger, regardless of container width.
			// (Slightly reduced to prevent clipping at canvas edges.)
			// Allow smaller screens to scale down enough to avoid clipping.
			this.containerScale = THREE.MathUtils.clamp(scale * 1.05, 0.62, 1.08);

			const width = baseWidth * this.containerScale;
			const height = baseHeight * this.containerScale;
			this.meshWidth = width;
			this.meshHeight = height;

			const gridX = 20;
			const gridY = Math.floor(20 * (height / width));

			const vertices: number[] = [];
			const indices: number[] = [];

			for (let i = 0; i < gridX; i++) {
				for (let j = 0; j < gridY; j++) {
					const u = (i / (gridX - 1) - 0.5) * width;
					const v = (j / (gridY - 1) - 0.5) * height;

					const fx = 0.02 / scale;
					const fy = 0.03 / scale;

					const z1 = Math.sin(u * fx * Math.PI + v * fy * Math.PI) * 12 * scale;
					const z2 = Math.cos(v * fy * Math.PI - u * fx * Math.PI) * 8 * scale;
					const z3 = Math.sin((u + v) * fx * 0.5 * Math.PI) * 4 * scale;

					vertices.push(u, v, (z1 + z2 + z3) * 0.4);
				}
			}

			for (let i = 0; i < gridX; i++) {
				for (let j = 0; j < gridY; j++) {
					const index = i * gridY + j;
					if (j < gridY - 1) indices.push(index, index + 1);
					if (i < gridX - 1) indices.push(index, index + gridY);
				}
			}

			if (this.geometry) this.geometry.dispose();
			if (this.material) this.material.dispose();

			this.geometry = new THREE.BufferGeometry();
			this.geometry.setAttribute('position', new THREE.Float32BufferAttribute(vertices, 3));
			this.geometry.setIndex(indices);
			this.originalPositions = new Float32Array(vertices);

			this.material = new THREE.LineBasicMaterial({
				color: 0xd7dee6,
				linewidth: 1,
				opacity: 0.9,
				transparent: true,
			});

			if (this.mesh) this.scene.remove(this.mesh);
			this.mesh = new THREE.LineSegments(this.geometry, this.material);
			this.mesh.rotation.x = -Math.PI * 0.18;
			// Keep centered; framing will ensure it fits the viewport.
			this.mesh.position.x = 0;
			this.mesh.position.y = 0;
			this.scene.add(this.mesh);
		}

		private setupResizeObserver(canvas: HTMLCanvasElement): void {
			this.resizeObserver = new ResizeObserver(() => {
				this.updateSize();
				this.createMesh();
				this.frameToView();
			});
			const container = canvas.parentElement;
			if (container) this.resizeObserver.observe(container);
		}

		private updateSize(): void {
			const container = this.renderer.domElement.parentElement;
			if (!container) return;
			const rect = container.getBoundingClientRect();
			this.renderer.setSize(rect.width, rect.height, false);
			this.camera.aspect = rect.width / rect.height;
			this.camera.updateProjectionMatrix();
		}

		private setupEventListeners(canvas: HTMLCanvasElement): void {
			canvas.style.cursor = 'grab';

			canvas.addEventListener('pointerenter', () => {
				this.isPointerOver = true;
				if (!this.isDragging) canvas.style.cursor = 'grab';
			});

			canvas.addEventListener('pointerleave', () => {
				this.isPointerOver = false;
				this.isDragging = false;
				this.activePointerId = null;
				canvas.style.cursor = 'default';
				this.resetMesh();
			});

			canvas.addEventListener('pointerdown', (event) => this.onPointerDown(event));
			canvas.addEventListener('pointerup', (event) => this.onPointerUp(event));
			canvas.addEventListener('pointercancel', (event) => this.onPointerUp(event));
			canvas.addEventListener('pointermove', (event) => this.onPointerMove(event));
		}

		private onPointerDown(event: PointerEvent): void {
			this.isDragging = true;
			this.activePointerId = event.pointerId;
			(event.currentTarget as HTMLCanvasElement).setPointerCapture(event.pointerId);
			(event.currentTarget as HTMLElement).style.cursor = 'grabbing';
			this.updatePointerPosition(event);
			this.previousMouse.copy(this.mouse);
		}

		private onPointerUp(event: PointerEvent): void {
			if (this.activePointerId !== event.pointerId) return;
			this.isDragging = false;
			this.activePointerId = null;
			(event.currentTarget as HTMLElement).style.cursor = 'grab';
		}

		private updatePointerPosition(event: PointerEvent): void {
			const rect = (event.currentTarget as HTMLElement).getBoundingClientRect();
			this.mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
			this.mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
		}

		private onPointerMove(event: PointerEvent): void {
			if (this.activePointerId !== null && this.activePointerId !== event.pointerId) return;
			this.updatePointerPosition(event);
			if (this.isDragging) {
				(event.currentTarget as HTMLElement).style.cursor = 'grabbing';
				this.updateMesh(true);
			} else if (this.isPointerOver) {
				this.updateMesh(false);
			}
			this.previousMouse.copy(this.mouse);
		}

		private resetMesh(): void {
			const positions = this.geometry.attributes.position.array as Float32Array;
			const animationTarget: Record<string, number> = {};
			for (let i = 0; i < positions.length; i++) {
				animationTarget[String(i)] = this.originalPositions[i]!;
			}
			gsap.to(positions, {
				duration: 0.8,
				...animationTarget,
				ease: 'elastic.out(1, 0.3)',
				onUpdate: () => {
					this.geometry.attributes.position.needsUpdate = true;
					this.render();
				},
			});
		}

		private updateMesh(isDragging: boolean): void {
			const positions = this.geometry.attributes.position.array as Float32Array;

			const scale = this.containerScale || 1;
			const mouseWorld = new THREE.Vector3(
				this.mouse.x * this.meshWidth,
				this.mouse.y * (this.meshHeight / 2),
				0,
			);
			mouseWorld.applyAxisAngle(new THREE.Vector3(1, 0, 0), -Math.PI * 0.18);

			const mouseDelta = isDragging
				? new THREE.Vector2(this.mouse.x - this.previousMouse.x, this.mouse.y - this.previousMouse.y)
				: new THREE.Vector2(0, 0);

			for (let i = 0; i < positions.length; i += 3) {
				const vertexPosition = new THREE.Vector3(positions[i]!, positions[i + 1]!, positions[i + 2]!);
				const distance = mouseWorld.distanceTo(vertexPosition);

				const maxDistance = (isDragging ? 0.58 : 0.42) * this.meshWidth;
				let influence = Math.max(0, 1 - distance / maxDistance);
				if (isDragging) influence = Math.pow(influence, 1.5);

				if (influence > 0) {
					const direction = vertexPosition.sub(mouseWorld).normalize();
					const targetPosition = new THREE.Vector3(
						this.originalPositions[i]!,
						this.originalPositions[i + 1]!,
						this.originalPositions[i + 2]!,
					);

					const stretchAmount = isDragging
						? (15 +
								Math.sqrt(mouseDelta.x * mouseDelta.x + mouseDelta.y * mouseDelta.y) * 20) *
							scale
						: 3 * scale;

					targetPosition.add(direction.multiplyScalar(influence * stretchAmount));

					const animationTarget: Record<string, number> = {
						[String(i)]: targetPosition.x,
						[String(i + 1)]: targetPosition.y,
						[String(i + 2)]: targetPosition.z,
					};

					gsap.to(positions, {
						duration: isDragging ? 0.15 : 0.3,
						...animationTarget,
						ease: isDragging ? 'power2.out' : 'power1.out',
						onUpdate: () => {
							this.geometry.attributes.position.needsUpdate = true;
							this.render();
						},
					});
				}
			}
		}

		private render(): void {
			this.renderer.render(this.scene, this.camera);
		}

		public cleanup(): void {
			if (this.resizeObserver) this.resizeObserver.disconnect();
			if (this.geometry) this.geometry.dispose();
			if (this.material) this.material.dispose();
			if (this.mesh) this.scene.remove(this.mesh);
		}
	}

	const canvas = document.querySelector('#hero-cloud-canvas');
	if (canvas instanceof HTMLCanvasElement) {
		if (window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches) {
			// No-op for reduced motion.
		} else {
			// Avoid double-init during HMR.
			// @ts-expect-error attach instance to window
			if (!window.__dclHeroCloud) {
				// @ts-expect-error attach instance to window
				window.__dclHeroCloud = new WavyMesh(canvas);
			}
		}
	}
</script>

