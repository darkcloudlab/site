---
// molecules/StatsCard.astro
import BaseCard from "../atoms/BaseCard.astro";

interface Props {
  title: string;
  subtitle: string;
  variant?: "default" | "gradient" | "dark";
  textAlign?: "left" | "center" | "right";
  titleSize?: "normal" | "large" | "xlarge";
  titleColor?: string;
  subtitleStyle?: "normal" | "stacked";
  className?: string;
}

const {
  title,
  subtitle,
  variant = "default",
  textAlign = "center",
  titleSize = "normal",
  titleColor = "",
  subtitleStyle = "normal",
  className = "",
} = Astro.props;

// Text alignment classes
const alignClasses = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
};

// Title size classes
const titleSizes = {
  normal: "text-2xl",
  large: "text-4xl",
  xlarge: "text-6xl",
};

// Determine if we should use stacked subtitle style
const isStacked = subtitleStyle === "stacked";
---

<BaseCard variant={variant} className={className}>
  <div
    class={`flex flex-col gap-2 relative z-10 w-full ${alignClasses[textAlign]}`}
    style="transform: translateZ(20px)"
  >
    <h3
      class={`font-bold ${titleSizes[titleSize]}`}
      style={titleColor ? `color: ${titleColor};` : ""}
    >
      {title}
    </h3>

    {
      isStacked ? (
        subtitle
          .split(".")
          .map((item) => item.trim())
          .filter(Boolean)
          .map((line) => (
            <p class="text-3xl font-bold opacity-90 leading-tight">{line}.</p>
          ))
      ) : (
        <p class="text-lg opacity-80 mt-2">{subtitle}</p>
      )
    }

    <slot />
  </div>
</BaseCard>
