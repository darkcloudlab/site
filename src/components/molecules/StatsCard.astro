---
// molecules/StatsCard.astro
import BaseCard from "../atoms/BaseCard.astro";

interface Props {
  title: string;
  subtitle: string;
  variant?: "default" | "gradient" | "dark";
  aspectRatio?: "square" | "rectangle";
  textAlign?: "left" | "center" | "right";
  titleSize?: "normal" | "large" | "xlarge";
  titleColor?: string;
  subtitleStyle?: "normal" | "stacked";
  className?: string;
}

const {
  title,
  subtitle,
  variant = "default",
  aspectRatio = "square", // Default to square
  textAlign = "center",
  titleSize = "normal",
  titleColor = "",
  subtitleStyle = "normal",
  className = "",
} = Astro.props;

// Text alignment classes
const alignClasses = {
  left: "text-left",
  center: "text-center",
  right: "text-right",
};

// Adjust title sizes based on square format
// Square cards typically need larger text to fill the space effectively
const titleSizes = {
  normal: aspectRatio === "square" ? "text-3xl" : "text-2xl",
  large: aspectRatio === "square" ? "text-5xl" : "text-4xl",
  xlarge: "text-6xl",
};

// Determine if we should use stacked subtitle style
const isStacked = subtitleStyle === "stacked";
---

<BaseCard variant={variant} aspectRatio={aspectRatio} className={className}>
  <div
    class={`flex flex-col gap-3 relative z-10 w-full h-full ${alignClasses[textAlign]}`}
    style="transform: translateZ(20px)"
  >
    {/* For square cards, we want to center content vertically */}
    <div class="flex flex-col justify-center h-full">
      <h3
        class={`font-bold ${titleSizes[titleSize]} leading-tight`}
        style={titleColor ? `color: ${titleColor};` : ""}
      >
        {title}
      </h3>

      {
        isStacked ? (
          <div class="mt-2">
            {subtitle
              .split(".")
              .map((item) => item.trim())
              .filter(Boolean)
              .map((line) => (
                <p class="text-3xl font-bold opacity-90 leading-tight">
                  {line}.
                </p>
              ))}
          </div>
        ) : (
          <p
            class={`opacity-80 mt-2 ${aspectRatio === "square" ? "text-xl" : "text-lg"}`}
          >
            {subtitle}
          </p>
        )
      }

      <slot />
    </div>
  </div>
</BaseCard>
