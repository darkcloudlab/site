---
// molecules/StatsCard.astro
interface Props {
  title: string;
  subtitle: string;
  variant?: "default" | "gradient" | "dark";
  className?: string;
}

const { title, subtitle, variant = "default", className = "" } = Astro.props;

const variants = {
  default: "text-white glassmorphic-card",
  gradient: "text-white glassmorphic-card gradient-variant",
  dark: "text-white glassmorphic-card dark-variant",
};

const cardStyle = `stats-card rounded-3xl p-6 relative overflow-hidden min-h-[240px] flex items-center justify-center ${variants[variant]} ${className}`;
---

<div class={cardStyle} data-tilt>
  <div
    class="flex flex-col gap-2 relative z-10 text-center w-full"
    style="transform: translateZ(20px)"
  >
    <h3 class="text-2xl font-bold">{title}</h3>
    <p class="text-lg opacity-80 mt-2">{subtitle}</p>
    <slot />
  </div>
</div>

<script>
  function handleMouseMove(event: MouseEvent, card: HTMLElement): void {
    const rect = card.getBoundingClientRect();
    const x = event.clientX - rect.left;
    const y = event.clientY - rect.top;

    const centerX = rect.width / 2;
    const centerY = rect.height / 2;

    const rotateX = ((y - centerY) / centerY) * -10;
    const rotateY = ((x - centerX) / centerX) * 10;

    card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    card.style.boxShadow = `0 30px 50px rgba(0, 0, 0, 0.2), 
                        ${rotateY / 2}px ${rotateX / 2}px 20px rgba(0, 0, 0, 0.1)`;
  }

  function resetCard(card: HTMLElement): void {
    card.style.transform = "perspective(1000px) rotateX(0) rotateY(0)";
    card.style.boxShadow = "0 10px 30px rgba(0, 0, 0, 0.1)";
  }

  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll<HTMLElement>(".stats-card");
    cards.forEach((card) => {
      card.addEventListener("mousemove", (e: MouseEvent) =>
        handleMouseMove(e, card),
      );
      card.addEventListener("mouseleave", () => resetCard(card));
    });
  });
</script>

<style>
  .stats-card {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    transition:
      transform 0.1s ease-out,
      box-shadow 0.1s ease-out;
    will-change: transform, box-shadow;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .glassmorphic-card {
    /* The background gradient now fills the entire card */
    background: linear-gradient(
      135deg,
      rgba(37, 99, 235, 0.95) 0%,
      rgba(37, 99, 235, 0.85) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }

  /* Shine effect layer that extends fully to the borders */
  .glassmorphic-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
  }

  .gradient-variant {
    background: linear-gradient(
      135deg,
      rgba(239, 68, 68, 0.95) 0%,
      rgba(219, 39, 119, 0.85) 100%
    );
  }

  .dark-variant {
    background: linear-gradient(
      135deg,
      rgba(23, 37, 84, 0.95) 0%,
      rgba(23, 37, 84, 0.85) 100%
    );
  }
</style>
