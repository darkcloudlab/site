---
import type { Capability } from '../content/site';

type Props = {
	items: Capability[];
};

const { items } = Astro.props;
---

<div class="gridWrap">
	{items.map((c) => (
		<article class="card cap">
			<div class="top">
				<div class="pill">
					<span class="dot" aria-hidden="true"></span>
					<span>{c.verb}</span>
				</div>
				<h3 class="title">{c.title}</h3>
				<p class="muted desc">{c.description}</p>
			</div>
			<ul class="list" role="list">
				{c.bullets.map((b) => (
					<li class="item">
						<span class="check" aria-hidden="true"></span>
						<span>{b}</span>
					</li>
				))}
			</ul>
		</article>
	))}
</div>

<style>
	.gridWrap {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}
	.cap {
		padding: 1.25rem 1.2rem;
		transform: translateY(0);
		transition: transform 350ms var(--ease-out);
	}
	.cap:hover {
		transform: translateY(-2px);
	}
	.top {
		display: grid;
		gap: 0.7rem;
	}
	.title {
		margin: 0;
		font-size: 1.15rem;
		letter-spacing: -0.02em;
	}
	.desc {
		margin: 0;
		line-height: 1.6;
	}
	.dot {
		width: 9px;
		height: 9px;
		border-radius: 999px;
		background: rgba(var(--accent-1), 0.95);
		box-shadow: 0 0 0 6px rgba(var(--accent-0), 0.16);
	}
	.list {
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.item {
		list-style: none;
		display: grid;
		grid-template-columns: 18px 1fr;
		align-items: start;
		gap: 0.6rem;
		color: rgba(var(--fog-1), 0.92);
	}
	.check {
		width: 16px;
		height: 16px;
		border-radius: 6px;
		background: linear-gradient(
			180deg,
			rgba(var(--fog-0), 0.16),
			rgba(var(--fog-2), 0.08)
		);
		border: 1px solid rgba(var(--fog-2), 0.22);
		position: relative;
		top: 2px;
	}
	.check::after {
		content: '';
		position: absolute;
		left: 4px;
		top: 4px;
		width: 6px;
		height: 3px;
		border-left: 2px solid rgba(var(--accent-1), 0.9);
		border-bottom: 2px solid rgba(var(--accent-1), 0.9);
		transform: rotate(-45deg);
	}

	@media (min-width: 820px) {
		.gridWrap {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1100px) {
		.gridWrap {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>

