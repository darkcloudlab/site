---
// molecules/BaseCard.astro
interface Props {
  variant?: "default" | "gradient" | "dark";
  className?: string;
  aspectRatio?: "square" | "rectangle" | "featured";
}

const {
  variant = "default",
  className = "",
  aspectRatio = "square",
} = Astro.props;

// Variant background gradients
const variantGradients = {
  default:
    "background: linear-gradient(135deg, rgba(37, 99, 235, 0.95) 0%, rgba(37, 99, 235, 0.85) 100%);",
  gradient:
    "background: linear-gradient(135deg, rgba(239, 68, 68, 0.95) 0%, rgba(219, 39, 119, 0.85) 100%);",
  dark: "background: linear-gradient(135deg, rgba(23, 37, 84, 0.95) 0%, rgba(23, 37, 84, 0.85) 100%);",
};

// Determine aspect ratio class based on the prop
const aspectClasses = {
  square: "aspect-square", // This ensures a perfect 1:1 aspect ratio
  rectangle: "min-h-[240px]", // Traditional rectangle shape
  featured: "min-h-[520px]", // Taller featured card
};

const aspectClass = aspectClasses[aspectRatio];
const cardStyle = `tilt-card glassmorphic-effect p-6 text-white relative overflow-hidden ${aspectClass} ${className}`;
---

<div class={cardStyle} style={variantGradients[variant]}>
  <slot />
</div>

<script>
  // Tilt effect logic
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll<HTMLElement>(".tilt-card");
    cards.forEach((card) => {
      card.addEventListener("mousemove", (e: MouseEvent) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        // Reduce tilt effect slightly for square cards to prevent distortion
        const tiltFactor = card.classList.contains("aspect-square") ? 8 : 10;
        const rotateX = ((y - centerY) / centerY) * -tiltFactor;
        const rotateY = ((x - centerX) / centerX) * tiltFactor;

        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
        card.style.boxShadow = `0 30px 50px rgba(0, 0, 0, 0.2), 
                            ${rotateY / 2}px ${rotateX / 2}px 20px rgba(0, 0, 0, 0.1)`;
      });

      card.addEventListener("mouseleave", () => {
        card.style.transform = "perspective(1000px) rotateX(0) rotateY(0)";
        card.style.boxShadow = "0 10px 30px rgba(0, 0, 0, 0.1)";
      });
    });
  });
</script>

<style>
  .tilt-card {
    transform-style: preserve-3d;
    transform: perspective(1000px);
    transition:
      transform 0.1s ease-out,
      box-shadow 0.1s ease-out;
    will-change: transform, box-shadow;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    border-radius: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Square cards need special handling to maintain aspect ratio */
  .aspect-square {
    aspect-ratio: 1 / 1;
    width: 100%;
    height: auto;
  }

  .glassmorphic-effect {
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
  }

  .glassmorphic-effect::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.1) 0%,
      rgba(255, 255, 255, 0.05) 100%
    );
    pointer-events: none;
  }
</style>
