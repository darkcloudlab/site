    window.addEventListener("load", () => {
        // Create several points along the path to animate
        const numberOfPoints = 12;
        const pointDelays = Array.from(
            { length: numberOfPoints },
            (_, i) => i * 0.2,
        );

        // Create main timeline
        const tl = gsap.timeline({
            repeat: -1,
            yoyo: true,
            defaults: {
                duration: 8,
                ease: "sine.inOut",
            },
        });

        // Animate path points with slight offsets
        

        // Add subtle wave effect to stroke
        gsap.to("#net", {
            strokeDasharray: "1 6",
            strokeDashoffset: 10,
            duration: 2,
            repeat: -1,
            ease: "none",
            yoyo: true,
        });

        // Add very subtle rotation
        gsap.to("#net", {
            rotation: 0.5,
