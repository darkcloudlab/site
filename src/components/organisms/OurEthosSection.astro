    <!-- First Row with Left Overlay -->
    <div class="relative mb-12">
      <!-- Image Container with Absolute Positioning -->
      <div
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-56 w-6/12 z-10"
      >
        <div class="relative w-full">
          <img
            src="/images/figma-macbook-air-2022.png"
            alt="Laptop showing company logo"
            class="w-full rounded-2xl shadow-xl"
          />
        </div>
      </div>

      <!-- Blue Card with Text -->
      <div class="relative ml-auto w-10/12 bg-blue-600 rounded-2xl p-8 pl-24">
        <div class="max-w-2xl ml-auto">
          <h3 class="text-white text-xl font-semibold mb-4">
            Beyond the Dark Cloud
          </h3>
          <p class="text-white text-lg leading-relaxed">
            Beyond the Dark Cloud lies our brightest purpose: creating solutions
            that genuinely improve lives. We believe technology should be a
            force for good, empowering users and communities alike. Every line
            of code we write, every interface we design, and every solution we
            develop is guided by a simple question: How will this make your
            world better? This commitment to positive impact isn't just a
            tagline – it's woven into the fabric of every project we undertake.
          </p>
        </div>
      </div>
    </div>

    <!-- Second Row with Right Overlay -->
    <div class="relative">
      <!-- Image Container with Absolute Positioning -->
      <div
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-56 w-6/12 z-10"
      >
        <div class="relative w-full">
          <img
            src="/images/figma-metal-packages.png"
            alt="Company logo on textured background"
            class="w-full rounded-2xl shadow-xl"
          />
        </div>
      </div>

      <!-- Blue Card with Text -->
      <div class="relative mr-auto w-10/12 bg-blue-600 rounded-2xl p-8 pr-24">
        <div class="max-w-2xl">
          <h3 class="text-white text-xl font-semibold mb-4">
            Intelligent Solutions
          </h3>
          <p class="text-white text-lg leading-relaxed">
            We specialize in developing intelligent software solutions that
            bridge the gap between powerful technology and everyday usability.
            Our expertise spans mobile application development, artificial
            intelligence integration, and scalable SaaS platforms. Whether it's
            creating AI-powered mobile apps that adapt to user behavior or
            building robust SaaS solutions that grow with your business, we
            deliver products that stand out in today's crowded digital
            landscape.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    contain: paint;
  }

  .title-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 2rem 0;
  }

  .title-container svg {
    width: 100%;
    max-width: 570px;
    height: auto;
    display: block;
  }
</style>
