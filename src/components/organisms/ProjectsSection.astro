<style>
  /* Using contain: paint to properly manage the rendering context */
  section {
    contain: paint;
  }

  /* Table styles for clean presentation */
  table {
    border-collapse: separate;
    border-spacing: 0;
  }

  /* Smooth hover transitions */
  tbody tr {
    transition: background-color 0.2s ease-in-out;
  }

  .title-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin-bottom: 4rem;
  }

  .title-container svg {
    width: 100%;
    max-width: 570px;
    height: auto;
    display: block;
  }
</style>
