---
// ProjectsSection.astro
interface Project {
  title: string;
  date: string;
  type: string;
}

const projects: Project[] = [
  {
    title: "Micro SaaS - Get your business connected",
    date: "01/02/24",
    type: "Saas",
  },
  {
    title: "Evo - Redesign of the BC Evo App",
    date: "01/02/24",
    type: "Client",
  },
  {
    title: "AI Integration - getting your AI online",
    date: "01/02/24",
    type: "Research",
  },
  {
    title: "ChatTo",
    date: "01/02/24",
    type: "AI (Client)",
  },
  {
    title: "Interview Prep",
    date: "01/02/24",
    type: "AI (Client)",
  },
];
---

<div class="section-wrapper">
  <section class="relative min-h-screen bg-gray-900 py-16">
    <!-- Radial gradient background effect that ensures full coverage -->
    <div class="absolute inset-0">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full">
        <div
          class="absolute top-40 right-0 w-[800px] h-[800px] rounded-full bg-blue-600/20 blur-3xl"
        >
        </div>
        <div
          class="absolute top-80 right-40 w-[600px] h-[600px] rounded-full bg-purple-600/20 blur-3xl"
        >
        </div>
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2
        class="text-6xl font-bold text-white mb-16 text-center tracking-wider"
      >
        Projects
      </h2>

      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="border-b border-white/10">
              <th class="text-left py-4 text-gray-400 font-normal text-lg"
                >Title</th
              >
              <th class="text-left py-4 text-gray-400 font-normal text-lg"
                >Date</th
              >
              <th class="text-left py-4 text-gray-400 font-normal text-lg"
                >Type</th
              >
            </tr>
          </thead>
          <tbody>
            {
              projects.map((project) => (
                <tr
                  class="border-b border-white/10 hover:bg-white/5 transition-colors cursor-pointer"
                  onclick="window.location.href='/projects/' + encodeURIComponent(project.title.toLowerCase().replace(/ /g, '-'))"
                >
                  <td class="py-6">
                    <h3 class="text-white text-xl font-medium">
                      {project.title}
                    </h3>
                  </td>
                  <td class="py-6">
                    <span class="text-white text-xl">{project.date}</span>
                  </td>
                  <td class="py-6">
                    <span class="text-white text-xl">{project.type}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<style>
  /* Wrapper ensures the section extends fully edge-to-edge */
  .section-wrapper {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow-x: clip;
  }

  /* Table styles for clean presentation */
  table {
    border-collapse: separate;
    border-spacing: 0;
  }

  /* Gradient text effect for heading */
  h2 {
    background: linear-gradient(to right, #fff, #e2e8f0);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Smooth hover transitions */
  tbody tr {
    transition: background-color 0.2s ease-in-out;
  }
</style>
