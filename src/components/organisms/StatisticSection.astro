---
// organisms/StatisticSection.astro
import StatsCard from "../molecules/StatsCard.astro";
import FeaturedStatsCard from "../molecules/FeaturedStatsCard.astro";

const stars = Array(5).fill("★");
---

<section class="stats-section">
  <div class="content-wrapper h-full">
    <div class="grid-container h-full">
      <!-- Square blue card -->
      <StatsCard
        title="Mobile Development"
        subtitle="React Native & Flutter specialists"
        aspectRatio="square"
      />

      <!-- Featured stats card in center -->
      <div class="row-span-2 featured-card-wrapper">
        <FeaturedStatsCard
          topText="Insert some statistic"
          statistic="100k"
          bottomText="Insert some statistic name"
        />
      </div>

      <!-- Orange text accent card -->
      <StatsCard
        title="Create with AI"
        subtitle="Harness Machine learning"
        titleColor="#FF5733"
        aspectRatio="square"
      />

      <!-- Info card -->
      <StatsCard
        title="Info"
        subtitle="Insert some statistic"
        aspectRatio="square"
      />

      <!-- Dark card with stacked text -->
      <StatsCard
        title="We Are"
        subtitle="Agile. Focused. Personal."
        variant="dark"
        textAlign="right"
        subtitleStyle="stacked"
        aspectRatio="square"
      />
    </div>
  </div>
</section>

<style>
  .stats-section {
    position: relative;
    min-height: 100vh;
    width: 100vw;
    background-color: rgb(37, 99, 235); /* Tailwind blue-600 */
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2rem 0;
  }

  .content-wrapper {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
  }

  .grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem; /* Increased gap for better visual separation of square cards */
    width: 100%;
  }

  /* Add this for the featured card wrapper */
  .featured-card-wrapper {
    height: 100%;
    display: flex;
  }

  /* This targets the actual BaseCard inside FeaturedStatsCard */
  .featured-card-wrapper > :global(*) {
    width: 100%;
    height: 100%;
  }

  /* This ensures the inner content expands fully */
  .featured-card-wrapper :global(.glassmorphic-effect) {
    height: 100%;
  }

  /* Responsive adjustments */
  @media (min-width: 1024px) {
    .grid-container {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .content-wrapper {
      padding: 4rem 1rem;
    }

    /* On smaller screens, we might want to reduce the gap slightly */
    .grid-container {
      gap: 1rem;
    }
  }
</style>
