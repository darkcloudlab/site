<style>
  /* Base container styling */
  .section-container {
    position: relative;
    min-height: 100vh;
    width: 100vw;
    background: url("/iPhone-15-Pro.svg") no-repeat center center;
    background-size: cover;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .background-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      /* Dark overlay */ 180deg,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(0, 0, 0, 0.2) 50%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 1; /* Below the content but above the background */
    pointer-events: none;
  }

  /* Content container with proper stacking */
  .content-container {
    position: relative;
    z-index: 2; /* Ensures content stays above the background */
    width: 100%;
    margin: 0 8rem;
    padding: 6rem 1.5rem;
  }

  .title-container {
    transform: scale(0.7); /* Scale down to 70% */
    transform-origin: left; /* Scale relative to the start */
    margin-bottom: 1rem;
  }

  .text-container {
    max-width: 48rem;
  }

  .description {
    font-family: "Inter", system-ui, sans-serif;
    font-size: clamp(1.25rem, 3vw, 2rem);
    line-height: 1.5;
    color: rgb(243, 244, 246);
    letter-spacing: 0.025em;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .content-container {
      padding: 4rem 1rem;
    }

    .text-container {
      max-width: 100%;
    }
  }

  /* Enhanced focus handling for accessibility */
  .section-container:focus-within {
    outline: none;
    box-shadow: inset 0 0 0 4px rgba(59, 130, 246, 0.5);
  }

  /* Additional visual enhancements */
  @media (prefers-reduced-motion: no-preference) {
    .title {
      animation: fadeSlideIn 0.8s ease-out;
    }

    .description {
      animation: fadeSlideIn 0.8s ease-out 0.2s backwards;
    }
  }

  @keyframes fadeSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
