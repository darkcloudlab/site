---
// ContactSection.astro
---

<section class="relative w-screen min-h-screen bg-gray-900 overflow-hidden">
  {/* Background gradient effect - creates the soft blue glow */}
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute inset-0">
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/20 blur-3xl rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-purple-600/20 blur-3xl rounded-full"
      >
      </div>
    </div>
  </div>

  {/* Content container using relative positioning for precise control */}
  <div class="relative w-full h-screen">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[640px] h-[400px]"
    >
      {/* Contact button - positioned closer to center */}
      <div class="absolute -top-1/3 -left-1/3">
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-4 bg-blue-600 rounded-full text-white text-2xl font-light tracking-wider hover:bg-blue-700 transition-colors"
        >
          Contact
          <span class="ml-2">→</span>
        </a>
      </div>

      {/* Centered logo */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="w-50 h-50 relative">
          <img
            src="/logo/logo-white.svg"
            alt="Dark Cloud Lab Logo"
            class="w-full h-full"
          />
        </div>
      </div>

      {/* Sign Up button - positioned closer to center */}
      <div class="absolute -bottom-1/3 -right-1/3">
        <a
          href="/signup"
          class="inline-flex items-center px-8 py-4 bg-blue-600 rounded-full text-white text-2xl font-light tracking-wider hover:bg-blue-700 transition-colors"
        >
          Sign Up
          <span class="ml-2">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
    contain: paint;
  }

  a {
    transition: transform 0.2s ease-in-out;
  }

  a:hover {
    transform: translateY(-2px);
  }

  svg {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.1));
  }
</style>
