---
// ContactSection.astro
---

<section
  class="w-screen relative bg-gray-900 overflow-hidden min-h-screen flex items-center justify-center"
>
  {/* Background gradient effect - contained within the section boundaries */}
  <div class="absolute inset-0">
    <div class="absolute inset-0">
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/20 blur-3xl rounded-full"
      >
      </div>
      <div
        class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-purple-600/20 blur-3xl rounded-full"
      >
      </div>
    </div>
  </div>

  {/* Content container using relative positioning for precise control */}
  <div class="relative w-full h-screen">
    {/* Center container that defines the bounds of our tight cluster */}
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[640px] h-[400px]"
    >
      {/* Contact button - positioned closer to center */}
      <div class="absolute top-0 left-0">
        <a
          href="/contact"
          class="inline-flex items-center px-8 py-4 bg-blue-600 rounded-full text-white text-2xl font-light tracking-wider hover:bg-blue-700 transition-colors"
        >
          Contact
          <span class="ml-2">→</span>
        </a>
      </div>

      {/* Centered logo */}
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
        <div class="w-32 h-32 relative">
          <div
            class="w-full h-full bg-gray-100 rounded-full flex items-center justify-center p-4"
          >
            <svg
              class="w-full h-full"
              viewBox="0 0 100 100"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M50 0C22.4 0 0 22.4 0 50s22.4 50 50 50 50-22.4 50-50S77.6 0 50 0zm0 90C27.9 90 10 72.1 10 50S27.9 10 50 10s40 17.9 40 40-17.9 40-40 40z"
                fill="currentColor"></path>
            </svg>
          </div>
        </div>
      </div>

      {/* Sign Up button - positioned closer to center */}
      <div class="absolute bottom-0 right-0">
        <a
          href="/signup"
          class="inline-flex items-center px-8 py-4 bg-blue-600 rounded-full text-white text-2xl font-light tracking-wider hover:bg-blue-700 transition-colors"
        >
          Sign Up
          <span class="ml-2">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Using contain: paint for proper rendering containment */
  section {
    contain: paint;
  }

  /* Enhanced button interactions */
  a {
    transition: all 0.2s ease-in-out;
  }

  a:hover {
    transform: translateY(-2px);
  }

  /* Logo shadow effect */
  svg {
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.1));
  }
</style>
