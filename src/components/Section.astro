---
type Props = {
	id?: string;
	eyebrow?: string;
	title: string;
	lead?: string;
	variant?: 'default' | 'panel';
};

const { id, eyebrow, title, lead, variant = 'default' } = Astro.props;
---

<section id={id} class:list={['section', variant === 'panel' && 'panel']}>
	<div class="container">
		{eyebrow ? <p class="eyebrow">{eyebrow}</p> : null}
		<h2 class="section-title">{title}</h2>
		{lead ? <p class="lead">{lead}</p> : null}
		<div class="content">
			<slot />
		</div>
	</div>
</section>

<style>
	.content {
		margin-top: 1.75rem;
	}
	.panel > .container {
		border-radius: var(--radius-lg);
		padding: clamp(2rem, 4vw, 3rem);
		background: linear-gradient(180deg, rgba(var(--bg-2), 0.45), rgba(var(--bg-1), 0.18));
		border: 1px solid rgba(var(--fog-2), 0.18);
		box-shadow: var(--shadow-sm);
	}
</style>

